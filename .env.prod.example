# Forman production deployment with Docker Compose.
# Copy this file to .env and set the public URL and credentials.

# Application
FORMAN_BASE_ORIGIN=https://forms.example.com

# Set to true only when a trusted reverse proxy overwrites X-Forwarded-* headers.
FORMAN_TRUST_PROXY=true

# Credentials
# Set two separate random secrets of at least 32 characters each.
# For example, run openssl rand -hex 32 for each secret.
FORMAN_SESSION_SECRET=
FORMAN_ALTCHA_SECRET=

# Set an initial password of at least 20 characters for the Forman account.
FORMAN_INITIAL_ADMIN_PASSWORD=

# Password recovery
# Use at least 20 characters and remove the setting after a successful reset.
# FORMAN_ADMIN_PASSWORD_RESET=
