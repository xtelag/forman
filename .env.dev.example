# Forman development in Docker Sandbox.
# `make environment` creates .env.dev from this file when needed.

# Runtime
NODE_ENV=development

# Application
FORMAN_BASE_ORIGIN=http://localhost:3000
FORMAN_DATABASE_PATH=/data/forman.sqlite
FORMAN_TRUST_PROXY=true

# Credentials
FORMAN_SESSION_SECRET=forman-development-session-secret
FORMAN_ALTCHA_SECRET=forman-development-altcha-secret

# Initial password for the local Forman account.
FORMAN_INITIAL_ADMIN_PASSWORD=change-me

# Password recovery
# Use at least 20 characters and remove the setting after a successful reset.
# FORMAN_ADMIN_PASSWORD_RESET=
